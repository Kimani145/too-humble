{
  "expo": {
    "name": "Too Humble",
    "slug": "too-humble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toohumble",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2B5E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toohumble.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A2B5E"
      },
      "package": "com.toohumble.app",
      "googleMobileAdsAppId": "ca-app-pub-5469850868838947~9547538713",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5469850868838947~9547538713",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalised ads to you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Too Humble needs access to your photos to share faith content with the community.",
          "cameraPermission": "Too Humble needs camera access to capture and share faith moments."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "josephs-organization-en"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2db132af-5dfd-406a-b20b-8e20958ffbbe"
      }
    },
    "owner": "kimoney",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2db132af-5dfd-406a-b20b-8e20958ffbbe"
    }
  }
}
